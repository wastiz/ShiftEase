# =============================================================
# ShiftEase — self-hosting environment variables
# Copy this file to .env and fill in your values before running
# docker-compose up
# =============================================================

# PostgreSQL
POSTGRES_DB=shiftease
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# JWT — must be at least 32 characters, random
JWT_SECRET_KEY=super_secret_key_that_is_at_least_32_characters_long
JWT_ISSUER=ShiftEase
JWT_AUDIENCE=ShiftEaseUsers

# Email (SMTP) — used for password-reset emails
# Leave blank to disable email sending (password-reset will still generate tokens but not send)
SMTP_HOST=valnos04@gmail.com
SMTP_PORT=587
SMTP_USERNAME=valnos04@gmail.com
SMTP_PASSWORD=hegp spnm rioe lpiy
FROM_EMAIL=valnos04@gmail.com

# Frontend public URL of the backend API as seen from the USER'S BROWSER.
# Change this if you expose the backend on a custom domain or port.
# Default works for the standard docker-compose setup on localhost.
PUBLIC_API_URL=http://localhost:8080/api

# CORS — comma or semicolon-separated list of origins allowed to call the API.
# Must include wherever the frontend is served from.
CORS_ORIGINS=http://localhost:3000
